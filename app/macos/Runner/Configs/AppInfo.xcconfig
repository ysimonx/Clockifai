// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = Clockifai

// The application's bundle identifier
// Deux applications distinctes, installables côte à côte (bac à sable, base locale et session séparés) :
//   Debug           « Clockifai Dev », branchée sur la pile locale (make app-macos)
//   Release/Profile « Clockifai », production clockifai.kysoe.com (make app-build-macos)
PRODUCT_BUNDLE_IDENTIFIER = fr.clockifai.clockifai
PRODUCT_BUNDLE_IDENTIFIER[config=Debug] = fr.clockifai.clockifai.dev

// Nom affiché (menus, Dock, panneau de la barre de menus).
APP_DISPLAY_NAME = Clockifai
APP_DISPLAY_NAME[config=Debug] = Clockifai Dev

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Clockifai — logiciel libre et auto-hébergé.
