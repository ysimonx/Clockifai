# Caddy — profil prod. Trois noms DNS pointent vers ce serveur :
#   APP_DOMAIN      → application web Flutter + /api (Flask)
#   SUPABASE_DOMAIN → passerelle Supabase (Kong : auth, rest, realtime, storage, studio)
#   SYNC_DOMAIN     → PowerSync
# SITE_SCHEME=https (défaut) : Caddy obtient lui-même les certificats Let's Encrypt (ports 80/443 ouverts).
# SITE_SCHEME=http : derrière un reverse proxy partagé qui fait le TLS (docker-compose.edge.yml,
# deploy/edge/). Hébergement à la maison derrière une box : plans/05-hebergement-maison.md.

{
	email {$ACME_EMAIL}
	servers {
		# Garde l'IP du client transmise par un proxy frontal (X-Forwarded-For)
		trusted_proxies static private_ranges
	}
}

{$SITE_SCHEME:https}://{$APP_DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy services:5000
	}

	# Guide utilisateur : docs/guide monté en lecture seule ; ses vidéos (docs/guide/videos, hors git)
	# arrivent par `make guide-publish`. file_server gère les requêtes Range (saut dans une vidéo).
	redir /guide /guide/
	handle /guide/* {
		root * /srv
		file_server
		header Cache-Control "no-cache"
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
		header Cache-Control "no-cache"
		@assets path *.js *.wasm *.css *.png *.woff2 *.json
		header @assets Cache-Control "public, max-age=604800"
	}
}

{$SITE_SCHEME:https}://{$SUPABASE_DOMAIN} {
	# Même découpage que le Caddyfile officiel de Supabase :
	# les API passent par Kong, tout le reste est le Studio protégé par mot de passe.
	@supabase_api path /auth/v1/* /rest/v1/* /graphql/v1 /realtime/v1/* /storage/v1/* /functions/v1/* /mcp /sso/*

	handle @supabase_api {
		reverse_proxy kong:8000
	}

	handle {
		basic_auth {
			# DASHBOARD_PASSWORD_HASH est calculé au démarrage du conteneur (voir docker-compose.yml)
			{$DASHBOARD_USERNAME} {$DASHBOARD_PASSWORD_HASH}
		}
		reverse_proxy studio:3000
	}

	header -server
}

{$SITE_SCHEME:https}://{$SYNC_DOMAIN} {
	reverse_proxy powersync:8080
}
